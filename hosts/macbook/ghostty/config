theme = GitHub Dark
background = #24292e
foreground = #d1d5da
palette = 0=#586069
palette = 1=#ea4a5a
palette = 2=#34d058
palette = 3=#ffea7f
palette = 4=#2188ff
palette = 5=#b392f0
palette = 6=#39c5cf
palette = 7=#d1d5da
palette = 8=#959da5
palette = 9=#f97583
palette = 10=#85e89d
palette = 11=#ffea7f
